# App
NODE_ENV="development"
PORT=3000
API_PREFIX="api"

# Database (your local PostgreSQL, not Docker)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/infopoly?schema=public"

# JWT
JWT_SECRET="change-me-to-a-long-random-string-min-32-chars"
JWT_EXPIRES_IN="7d"

# Auth cookie
COOKIE_NAME="access_token"
COOKIE_SAME_SITE="lax"

# Security
BCRYPT_ROUNDS=10

# Swagger
SWAGGER_PATH="api/docs"

# CORS
CORS_ORIGIN="http://localhost:3001"

# Throttler (per-IP rate limiting on /auth)
THROTTLE_TTL=60
THROTTLE_LIMIT=5
