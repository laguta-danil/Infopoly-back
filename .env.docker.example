# Postgres (docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=infopoly
POSTGRES_PORT=5432

# Same DB on localhost (e2e, prisma CLI while compose is up)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/infopoly?schema=public

# API
API_PORT=3000
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=7d

# Auth cookie
COOKIE_NAME=access_token
COOKIE_SAME_SITE=lax

# Security
BCRYPT_ROUNDS=10

# Routing
API_PREFIX=api
SWAGGER_PATH=api/docs

# CORS
CORS_ORIGIN=http://localhost:3001

# Throttler
THROTTLE_TTL=60
THROTTLE_LIMIT=5
